<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>de.arion.letterbox</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/.arion/arion-letterbox.sh</string>
  </array>
  <!-- Startet sofort, wenn der Scanner etwas in den Ordner legt … -->
  <key>WatchPaths</key>
  <array>
    <string>__LETTERBOX_DIR__</string>
  </array>
  <!-- … und zusätzlich jede Minute, damit Dateien nach der 30-s-Wartezeit sicher mitgehen -->
  <key>StartInterval</key>
  <integer>60</integer>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
